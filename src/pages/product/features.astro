              <td class="px-4 py-3 text-center text-gray-500">Via extensions</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Built-in</td>
            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              <td class="px-4 py-3">Admin Activity Log</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Built-in audit trail</td>
              <td class="px-4 py-3 text-center text-gray-500">Via extensions</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Built-in</td>
            </tr>

            <!-- Development & Extensibility -->
            <tr class="bg-gray-50 dark:bg-gray-800/50">
              <td colspan="4" class="px-4 py-2 font-semibold text-gray-900 dark:text-white"
                >Development & Extensibility</td
              >
            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              <td class="px-4 py-3">Extension Compatibility</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Full Magento 2 compatibility</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Full</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Full + Commerce extensions</td>
