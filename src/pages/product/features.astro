              <td class="px-4 py-3 text-center text-gray-500">License + Adobe account</td>
            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              <td class="px-4 py-3">Interactive Installer</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400"
                >✓ <code>bin/magento install</code> wizard with service auto-detection</td
              >
              <td class="px-4 py-3 text-center text-gray-500"><code>setup:install</code> CLI only</td>
              <td class="px-4 py-3 text-center text-gray-500"><code>setup:install</code> CLI only</td>
            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
