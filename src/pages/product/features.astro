              <th scope="col" class="px-4 py-4 font-semibold text-center">Mage-OS</th>
              <th scope="col" class="px-4 py-4 font-semibold text-center">Magento Open Source</th>
              <th scope="col" class="px-4 py-4 font-semibold text-center">Adobe Commerce</th>
            </tr>
          </thead>
          <tbody>
            <!-- Licensing & Cost -->
            <tr class="bg-gray-50 dark:bg-gray-800/50">
              <td colspan="4" class="px-4 py-2 font-semibold text-gray-900 dark:text-white">Licensing & Cost</td>
            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              <td class="px-4 py-3">License</td>
              <td class="px-4 py-3 text-center">OSL 3.0 (Open Source)</td>
              <td class="px-4 py-3 text-center">OSL 3.0 (Open Source)</td>
              <td class="px-4 py-3 text-center">Proprietary</td>
            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              <td class="px-4 py-3">Cost</td>
              <td class="px-4 py-3 text-center">Free</td>
              <td class="px-4 py-3 text-center">Free</td>
              <td class="px-4 py-3 text-center">$22k–$125k+/year</td>
            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              <td class="px-4 py-3">Hosting</td>
              <td class="px-4 py-3 text-center">Self-hosted / Any provider</td>
              <td class="px-4 py-3 text-center">Self-hosted / Any provider</td>
              <td class="px-4 py-3 text-center">Self-hosted or Adobe Cloud</td>
            </tr>

            <!-- Core Features -->
            <tr class="bg-gray-50 dark:bg-gray-800/50">
              <td colspan="4" class="px-4 py-2 font-semibold text-gray-900 dark:text-white">Core E-commerce Features</td
