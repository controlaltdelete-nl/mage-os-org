            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
              <td class="px-4 py-3">B2C Commerce</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Full</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Full</td>
              <td class="px-4 py-3 text-center text-green-600 dark:text-green-400">✓ Full</td>
            </tr>
            <tr class="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
