---
import Layout from '~/layouts/PageLayout.astro';

import PageHero from '~/components/widgets/PageHero.astro';
import Note from '~/components/widgets/Note.astro';
import FeaturesWidget from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Mage-OS Features | Performance, Security & Innovation',
  description:
    'Discover how Mage-OS Distribution delivers enhanced performance, enterprise-grade security, built-in SEO, and community-driven innovation. 100% compatible with Magento extensions. Free and open source.',
  openGraph: {
    images: [{ url: '/og/page/features.png', width: 1200, height: 630 }],
  },
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <PageHero
    tagline="Mage-OS Distribution"
    variant="gradient"
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/get-started/quick-start',
        icon: 'tabler:download',
      },
      { text: 'Compare Editions', href: '#comparison' },
    ]}
  >
    <Fragment slot="title">
      Built for <span class="text-accent dark:text-white">Performance</span>, Secured by <span
        class="text-accent dark:text-white">Community</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      Mage-OS Distribution is built on Magento Open Source 2.4.9 with community-driven enhancements for performance,
      security, and developer experience. 100% compatible with existing Magento extensions. Free, open source, and ready
      for production.
    </Fragment>
  </PageHero>

  <!-- Note Widget ******************* -->

  <Note
    title="100% Upstream Compatible"
    description="Migrate from Magento Open Source in minutes. Your existing extensions, themes, and customizations work without modification."
  />

  <!-- Features Widget: Performance *************** -->

  <FeaturesWidget
    id="performance"
    tagline="Performance"
    title="Performance at Scale"
    subtitle="Optimized for speed and efficiency from development to production"
    items={[
      {
        title: 'Optimized Architecture',
        description:
          'Lightweight package composition reduces bloat and accelerates page load times compared to standard Magento configurations.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Advanced Caching',
        description:
          'Enhanced full-page cache, Varnish integration, and Redis optimization deliver sub-second response times.',
        icon: 'tabler:database',
      },
      {
        title: 'Database Efficiency',
        description:
          'Query optimization and indexing improvements reduce database load for higher concurrent user volumes.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Scalable Infrastructure',
        description:
          'Built to scale from startup to enterprise with horizontal scaling, microservices compatibility, and cloud-native deployment.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Back/Forward Cache',
        description:
          'bfcache support enables almost instant browser navigation for cacheable pages, improving Core Web Vitals.',
        icon: 'tabler:arrow-back-up',
      },
      {
        title: 'Speculative Preloading',
        description:
          'Intelligently preloads links before users click them for perceived instant navigation and smoother UX.',
        icon: 'tabler:link',
      },
      {
        title: 'PHP 8.4 Lazy Object Loading',
        description:
          'Built-in dependency injection support for PHP 8.4+ lazy objects reduces cold-start overhead for faster response times.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Optimized Varnish VCL',
        description:
          'Updated VCL configuration plus the bundled Varnish Extended module deliver richer cache controls and production-tuned defaults.',
        icon: 'tabler:server',
      },
      {
        title: 'WebP & AVIF Images',
        description:
          'Native upload and processing for modern image formats delivers smaller files and faster-loading catalog pages.',
        icon: 'tabler:photo',
      },
      {
        title: 'Faster DI Compilation',
        description:
          'setup:di:compile parses each di.xml scope once and stores compiled areas as a diff, so compiles finish sooner and generate less.',
        icon: 'tabler:stack-2',
      },
    ]}
  />

  <!-- Features Widget: Security *************** -->

  <FeaturesWidget
    id="security"
    tagline="Security"
    title="Security You Can Trust"
    subtitle="Enterprise-grade security with proactive community-driven improvements"
    classes={{ container: 'bg-orange-50 dark:bg-transparent' }}
    items={[
      {
        title: 'Proactive Patch Management',
        description:
          'Built on the latest Magento Open Source security releases with accelerated community-driven patches.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'PCI DSS 4.0 Compliance',
        description:
          'Updated admin policies including automatic account deactivation, session security, and strengthened authentication.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Passkeys & Two-Factor Authentication',
        description:
          'Optional passwordless passkey sign-in for customers, a passkey provider for admin 2FA, OAuth 2.0, and role-based access control.',
        icon: 'tabler:fingerprint',
      },
      {
        title: 'Security Audits',
        description: 'Community-led security audits and transparent vulnerability disclosure ensure rapid response.',
        icon: 'tabler:search',
      },
      {
        title: 'Strengthened Passwords',
        description: '12-character minimum length and complexity rules for enhanced account security.',
        icon: 'tabler:key',
      },
      {
        title: 'Session Management',
        description: '15-minute idle timeout enforcement and improved lockout policies protect admin accounts.',
        icon: 'tabler:clock',
      },
    ]}
  />

  <!-- Features Widget: SEO & Discoverability *************** -->

  <FeaturesWidget
    id="seo"
    tagline="SEO & Discoverability"
    title="Get Found Everywhere"
    subtitle="Search engines, AI assistants, and shopping channels, built in with no paid extensions needed"
    items={[
      {
        title: 'Structured Data Built In',
        description:
          'Google-ready JSON-LD for your organization, breadcrumbs, categories, and products, including variant groups for configurable products and the shipping and returns data merchant listings require.',
        icon: 'tabler:code',
      },
      {
        title: 'Social Share Cards',
        description:
          'Open Graph and X (Twitter) cards on product, category, and site pages, so shared links look right.',
        icon: 'tabler:share',
      },
      {
        title: 'Robots & Canonical Control',
        description:
          'Index and follow defaults with per-page overrides, pagination handling, snippet and AI directives, and automatic canonicals.',
        icon: 'tabler:route',
      },
      {
        title: 'Multistore Hreflang',
        description:
          'Hreflang links in the page head and sitemap, with x-default, for stores that sell across languages and regions.',
        icon: 'tabler:language',
      },
      {
        title: 'llms.txt for AI Assistants',
        description:
          'Opt-in /llms.txt summaries and a machine-readable product feed help AI assistants and answer engines understand your store.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'AI Crawler Controls',
        description: 'Decide which AI crawlers may index your store, with robots.txt rules managed per store view.',
        icon: 'tabler:shield-cog',
      },
      {
        title: 'FAQ Manager',
        description:
          'Manage FAQs in the admin, place them with a widget or Page Builder, and get FAQ rich results automatically.',
        icon: 'tabler:help-circle',
      },
      {
        title: 'Product Feeds',
        description:
          'Scheduled feeds for Google Shopping, Meta, Pinterest, TikTok, and Microsoft, with filters, category mapping, and SFTP delivery.',
        icon: 'tabler:rss',
      },
    ]}
  />

  <!-- Platform Comparison Section **************** -->

  <section id="comparison" class="relative py-16 md:py-20">
    <div class="absolute inset-0 bg-white dark:bg-slate-900"></div>
    <div class="relative px-4 sm:px-6 mx-auto lg:px-8 max-w-6xl">
      <div class="text-center mb-10">
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">Comparison</p>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading dark:text-gray-200">
          Platform Comparison
        </h2>
        <p class="max-w-3xl mx-auto text-xl text-muted dark:text-slate-400">
          An honest comparison of Mage-OS, Magento Open Source, and Adobe Commerce to help you choose the right
          platform.
        </p>
        <p class="text-sm text-muted dark:text-slate-500 mt-4">
          Comparing to Shopify or WooCommerce?
          <a href="/product/is-it-right-for-you" class="text-primary hover:underline">See our platform decision guide</a
          >
          to understand when Mage-OS is the right choice.
        </p>
      </div>

      <div class="relative overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm">
        <table class="w-full text-sm text-left text-gray-700 dark:text-gray-300">
          <thead class="text-xs uppercase bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">
            <tr>
